#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&sk { quick-release; };

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        layer_kp: layer_then_key {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to1 &to MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER>;
            label = "LAYER_THEN_KEY";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        gleathy {
            display-name = "Gleathy";
            bindings = <
&none          &kp N1      &kp N2   &kp N3     &kp N4     &kp N5  &tog 3                                                                                            &mo 4            &kp N6  &kp N7  &kp N8    &kp N9       &kp N0         &kp DELETE
&kp TAB        &kp COMMA   &kp O    &kp U      &kp L      &kp J   &kp C_PLAY_PAUSE                                                                                  &kp C_VOLUME_UP  &kp V   &kp F   &kp D     &kp G        &kp Q          &kp BSLH
&kp SEMICOLON  &kp I       &kp A    &kp E      &kp R      &kp W   &kp C_NEXT        &mt LEFT_COMMAND ESCAPE  &kp LEFT_CONTROL      &kp RIGHT_CONTROL  &kp LEFT_ALT  &kp C_VOL_DN     &kp Y   &kp H   &kp T     &kp S        &kp N          &kp MINUS
&none          &kp PERIOD  &kp SQT  &kp SLASH  &kp X      &kp Z                                              &mo 2                 &kp CAPSLOCK                                      &kp K   &kp P   &kp M     &kp C        &kp B          &none
&kp GLOBE      &kp HOME    &kp END  &kp LEFT   &kp RIGHT          &kp BSPC          &sk LEFT_SHIFT           &mo 3                 &to 1              &kp ENTER     &kp SPACE                &kp UP  &kp DOWN  &kp PAGE_UP  &kp PAGE_DOWN  &kp GLOBE
            >;
        };

        qwerty_ctrl {
            display-name = "Qwerty Ctrl";
            bindings = <
&none       &kp N1    &kp N2   &kp N3    &kp N4     &kp N5  &tog 3                                                                                                 &mo 4            &kp N6  &kp N7  &kp N8     &kp N9       &kp N0         &kp DELETE
&kp TAB     &kp Q     &kp W    &kp E     &kp R      &kp T   &kp C_PLAY_PAUSE                                                                                       &kp C_VOLUME_UP  &kp Y   &kp U   &kp I      &kp O        &kp P          &kp BSLH
&kp ESCAPE  &kp A     &kp S    &kp D     &kp F      &kp G   &kp C_NEXT        &mt LEFT_CONTROL ESCAPE  &kp LEFT_COMMAND      &kp RIGHT_COMMAND  &kp LEFT_ALT       &kp C_VOL_DN     &kp H   &kp J   &kp K      &kp L        &kp SEMICOLON  &kp SQT
&none       &kp Z     &kp X    &kp C     &kp V      &kp B                                              &mo 2                 &kp CAPSLOCK                                           &kp N   &kp M   &kp COMMA  &kp PERIOD   &kp SLASH      &none
&kp GLOBE   &kp HOME  &kp END  &kp LEFT  &kp RIGHT          &kp BSPC          &sk LEFT_SHIFT           &mo 3                 &to 0              &layer_kp 0 ENTER  &kp SPACE                &kp UP  &kp DOWN   &kp PAGE_UP  &kp PAGE_DOWN  &kp GLOBE
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2            &kp F3                &kp F4                 &kp F5      &kp F6         &tog 3                                      &mo 4   &kp F7       &kp F8    &kp F9    &kp F10    &kp F11  &kp F12
&trans  &kp ASTERISK      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PLUS    &kp TILDE      &trans                                      &trans  &kp POUND    &trans    &kp UP    &trans     &trans   &trans
&trans  &kp CARET         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL   &kp GRAVE      &trans  &trans  &trans      &trans  &trans  &trans  &kp PERCENT  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
&trans  &kp RA(NUMBER_3)  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DOLLAR  &kp AMPERSAND                  &trans      &trans                  &kp COMMA    &trans    &trans    &trans     &trans   &trans
&trans  &trans            &trans                &trans                 &trans                     &trans  &trans  &trans      &trans  &trans  &trans               &trans    &trans    &trans     &trans   &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1  &kp N2  &kp N3    &kp N4     &kp N5  &trans                                         &mo 4      &kp N6       &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &trans
&trans     &trans  &trans  &trans    &trans     &trans  &trans                                         &trans     &kp POUND    &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &trans
&trans     &trans  &trans  &trans    &trans     &trans  &trans  &trans  &trans      &trans  &trans     &trans     &kp PERCENT  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &trans
&trans     &trans  &trans  &trans    &trans     &trans                  &trans      &trans                        &kp COMMA    &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &trans
&trans     &trans  &trans  &kp LEFT  &kp RIGHT          &trans  &trans  &trans      &trans  &kp ENTER  &kp KP_N0               &kp UP      &kp DOWN      &kp KP_DOT     &none            &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &to 0         &to 1         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
